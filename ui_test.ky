// Cross-module test for kyte-ui: imports the kit and renders its components.
import ui;
import assert;
import string;

fn panel(): string {
    return <ui.Card title="Account">
        <ui.Badge tone={ui.Tone.Success}>active</ui.Badge>
        <ui.Alert tone={ui.Tone.Warning} title="Heads up">Your trial ends soon.</ui.Alert>
        <ui.Field label="Email"><input name="email"/></ui.Field>
        <ui.Disclosure summary="Details">Hidden content.</ui.Disclosure>
        <ui.Button tone={ui.Tone.Primary}>Save</ui.Button>
    </ui.Card>;
}

@test
fn test_renders_kit(): void {
    let h = panel();
    assert.isTrue(string.contains(h, "<section class=\"rounded-lg border border-slate-200 bg-white p-4 shadow-sm\">"));
    assert.isTrue(string.contains(h, "<h3 class=\"text-base font-semibold text-slate-800\">Account</h3>"));
    assert.isTrue(string.contains(h, "bg-green-100 text-green-800")); // Badge Success
    assert.isTrue(string.contains(h, ">active</span>"));
    assert.isTrue(string.contains(h, "Heads up"));
    assert.isTrue(string.contains(h, "Your trial ends soon."));
    assert.isTrue(string.contains(h, "<label class=\"block\">"));
    assert.isTrue(string.contains(h, "<input name=\"email\"/>"));
    assert.isTrue(string.contains(h, "<details class=\"rounded-md border border-slate-200\">"));
    assert.isTrue(string.contains(h, "<summary"));
    assert.isTrue(string.contains(h, "bg-blue-600 hover:bg-blue-700 text-white")); // Button Primary
    assert.isTrue(string.contains(h, ">Save</button>"));
}

@test
fn test_cls_override(): void {
    // Default cls leaves base classes unchanged; a provided cls is appended.
    assert.isTrue(string.contains(<ui.Badge tone={ui.Tone.Primary}>x</ui.Badge>, "text-blue-800\">x</span>"));
    assert.isTrue(string.contains(<ui.Badge tone={ui.Tone.Primary} cls="ml-2">x</ui.Badge>, "text-blue-800 ml-2\">x</span>"));
    assert.isTrue(string.contains(<ui.Card title="T" cls="w-96">body</ui.Card>, "shadow-sm w-96\">"));
}
